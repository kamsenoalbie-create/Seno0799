                            target.cpmiName = this.formMedikal.cpmiName;
                            target.clinicName = this.formMedikal.clinicName;
                            target.checkDate = this.formMedikal.checkDate;
                            target.price = Number(this.formMedikal.price) || 0;
                            target.clinicPrice = Number(this.formMedikal.clinicPrice) || 0;
                            target.status = this.formMedikal.status;
                            target.notes = this.formMedikal.notes;
                        }
                        this.notify('Data medikal berhasil diperbarui!', 'success', 'fa-solid fa-pen-to-square');
                    } else {
                        const newM = {
                            id: 'M-' + Date.now(),
                            cpmiName: this.formMedikal.cpmiName,
                            clinicName: this.formMedikal.clinicName,
                            checkDate: this.formMedikal.checkDate,
                            price: Number(this.formMedikal.price) || 0,
                            clinicPrice: Number(this.formMedikal.clinicPrice) || 0,
                            status: this.formMedikal.status,
                            notes: this.formMedikal.notes
                        };
                        this.medikalList.unshift(newM);
                        this.notify('Data medikal baru berhasil ditambahkan!', 'success', 'fa-solid fa-notes-medical');
                    }
                    this.showMedikalModal = false;
                },

