                exportProcessToCSV() {
                    const data = this.getProsesSpreadsheetData();
                    if (data.length === 0) {
                        this.notify('Tidak ada data untuk diexport!', 'warning', 'fa-solid fa-triangle-exclamation');
                        return;
                    }

                    let csvContent = "data:text/csv;charset=utf-8,";
                    csvContent += "No,Kode CPMI,Nama Lengkap,Tgl Lahir,Negara Tujuan,TB & BB,Jabatan,Sponsor,Tgl Tampung,Status Tahap,Tanggal Daftar\n";

                    data.forEach((item, index) => {
                        const row = [
                            index + 1,
                            `"${item.code}"`,
                            `"${item.name}"`,
                            `"${item.dob || '-'}"`,
                            `"${item.destination}"`,
                            `"${(item.tb || '-') + ' / ' + (item.bb || '-')}"`,
                            `"${item.jobRole}"`,
                            `"${item.sponsorNameManual || 'Direct'}"`,
                            `"${item.shelterDate || '-'}"`,
                            `"${item.status}"`,
                            `"${item.regDate}"`
                        ].join(",");
                        csvContent += row + "\n";
                    });

                    const encodedUri = encodeURI(csvContent);
                    const link = document.createElement("a");
                    link.setAttribute("href", encodedUri);
                    link.setAttribute("download", `Data_Proses_CPMI_${new Date().toISOString().split('T')[0]}.csv`);
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);

                    this.notify('Data spreadsheet berhasil diexport ke CSV / Excel!', 'success', 'fa-solid fa-file-csv');
                },

