                        const matchesSearch = (cb.cpmiName && cb.cpmiName.toLowerCase().includes(q)) || cb.category.toLowerCase().includes(q) || cb.description.toLowerCase().includes(q);
                        return matchesSearch;
                    });
                },

                printCpmiSingle(item) {
                    this.cetakReportType = 'cpmi';
                    this.cetakSearchQuery = item.name;
                    this.activeTab = 'menu-cetak';
                },

                triggerBrowserPrint() {
                    window.print();
                }
            }
        }
