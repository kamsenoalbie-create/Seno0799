                async backupToCloud() {
                    if (!window.firebaseModules) {
                        this.notify('Modul Firebase belum termuat.', 'error');
                        return;
                    }
                    this.isCloudLoading = true;
                    try {
                        const { initializeApp, getAuth, signInAnonymously, signInWithCustomToken, getFirestore, doc, setDoc } = window.firebaseModules;
                        const firebaseConfig = JSON.parse(typeof __firebase_config !== 'undefined' ? __firebase_config : '{}');
                        const app = initializeApp(firebaseConfig);
                        const auth = getAuth(app);
                        const db = getFirestore(app);

                        if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                            await signInWithCustomToken(auth, __initial_auth_token);
                        } else {
                            await signInAnonymously(auth);
                        }

                        const appId = typeof __app_id !== 'undefined' ? __app_id : 'default-app-id';
                        const userId = auth.currentUser?.uid || crypto.randomUUID();

                        const backupPayload = {
                            cpmiList: this.cpmiList,
                            medikalList: this.medikalList,
                            sponsorList: this.sponsorList,
                            p3miList: this.p3miList,
                            keuanganPusat: this.keuanganPusat,
                            keuanganCabang: this.keuanganCabang,
                            updatedAt: new Date().toISOString()
                        };

                        const docRef = doc(db, 'artifacts', appId, 'users', userId, 'backups', 'latest');
                        await setDoc(docRef, backupPayload);

                        this.notify('Berhasil backup data ke Google Cloud!', 'success', 'fa-solid fa-cloud-arrow-up');
                    } catch (e) {
                        console.error(e);
                        this.notify('Gagal backup ke Google Cloud: ' + e.message, 'error');
                    } finally {
                        this.isCloudLoading = false;
                    }
                },

                async restoreFromCloud() {
                    if (!window.firebaseModules) {
                        this.notify('Modul Firebase belum termuat.', 'error');
                        return;
                    }
                    this.isCloudLoading = true;
                    try {
                        const { initializeApp, getAuth, signInAnonymously, signInWithCustomToken, getFirestore, doc, getDoc } = window.firebaseModules;
                        const firebaseConfig = JSON.parse(typeof __firebase_config !== 'undefined' ? __firebase_config : '{}');
                        const app = initializeApp(firebaseConfig);
                        const auth = getAuth(app);
                        const db = getFirestore(app);

                        if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                            await signInWithCustomToken(auth, __initial_auth_token);
                        } else {
                            await signInAnonymously(auth);
                        }

                        const appId = typeof __app_id !== 'undefined' ? __app_id : 'default-app-id';
                        const userId = auth.currentUser?.uid || crypto.randomUUID();

                        const docRef = doc(db, 'artifacts', appId, 'users', userId, 'backups', 'latest');
                        const snap = await getDoc(docRef);

                        if (snap.exists()) {
                            const data = snap.data();
                            if (data.cpmiList) this.cpmiList = data.cpmiList;
                            if (data.medikalList) this.medikalList = data.medikalList;
                            if (data.sponsorList) this.sponsorList = data.sponsorList;
                            if (data.p3miList) this.p3miList = data.p3miList;
                            if (data.keuanganPusat) this.keuanganPusat = data.keuanganPusat;
                            if (data.keuanganCabang) this.keuanganCabang = data.keuanganCabang;

                            this.saveToLocalStorage();
                            this.updateChart();
                            this.notify('Berhasil restore data dari Google Cloud!', 'success', 'fa-solid fa-cloud-arrow-down');
                        } else {
                            this.notify('Tidak ditemukan file backup di Google Cloud.', 'warning');
                        }
                    } catch (e) {
                        console.error(e);
                        this.notify('Gagal restore dari Google Cloud: ' + e.message, 'error');
                    } finally {
                        this.isCloudLoading = false;
                    }
                },

                getCpmiTotalExpense(cpmiName) {
                    if (!cpmiName) return 0;
                    let total = 0;
                    this.keuanganCabang.forEach(item => {
                        if (item.cpmiName && item.cpmiName.toLowerCase() === cpmiName.toLowerCase()) {
                            total += (Number(item.dp1) || 0) + (Number(item.dp2) || 0) + (Number(item.pelunasan) || 0) + (Number(item.kasbon) || 0);
                        }
                    });
                    this.medikalList.forEach(m => {
                        if (m.cpmiName && m.cpmiName.toLowerCase() === cpmiName.toLowerCase()) {
                            total += (Number(m.price) || 0);
                        }
                    });
                    return total;
                },

                getTotalMedikalProfit() {
                    return this.medikalList.reduce((acc, m) => {
                        return acc + ((Number(m.price) || 0) - (Number(m.clinicPrice) || 0));
                    }, 0);
                },

                getTotalClinicPrice() {
                    return this.medikalList.reduce((acc, m) => {
                        return acc + (Number(m.clinicPrice) || 0);
                    }, 0);
                },

                getTotalCabangExpensePlusClinic() {
                    const totalCabang = this.keuanganCabang.reduce((acc, curr) => {
                        return acc + (Number(curr.dp1) || 0) + (Number(curr.dp2) || 0) + (Number(curr.pelunasan) || 0) + (Number(curr.kasbon) || 0);
                    }, 0);
                    return totalCabang + this.getTotalClinicPrice();
                },

                getCabangTotalProfit() {
                    const totalCabang = this.keuanganCabang.reduce((acc, curr) => {
                        return acc + (Number(curr.dp1) || 0) + (Number(curr.dp2) || 0) + (Number(curr.pelunasan) || 0) + (Number(curr.kasbon) || 0);
                    }, 0);
                    return totalCabang + this.getTotalMedikalProfit();
                },

                getFilteredMedikalList() {
                    const q = this.searchMedikal.toLowerCase();
                    return this.medikalList.filter(m => m.cpmiName.toLowerCase().includes(q) || m.clinicName.toLowerCase().includes(q));
                },

